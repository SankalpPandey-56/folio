rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Folio - Cloud Firestore Security Rules
    // Strict authentication and user-isolation enforcement.
    // =========================================================================

    // Deny all root-level collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User data is strictly isolated under /users/{userId}
    match /users/{userId} {
      // Allow user to read and write their own user profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User preferences (theme, goals, notification settings)
      match /preferences/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Books collection
      match /books/{bookId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reading sessions collection
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reflection journal entries and notes collection
      match /reflections/{reflectionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // AI-generated summaries, quizzes, and weekly reviews
      match /ai_artifacts/{artifactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
